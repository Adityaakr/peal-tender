{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "git config --global url.\"https://github.com/\".insteadOf \"ssh://git@github.com/\" && npm ci",
  "buildCommand": "npm run dashboard:build",
  "outputDirectory": "apps/dashboard/dist",
  "rewrites": [
    {
      "source": "/api/qore/rest/:path*",
      "destination": "https://api-testnet.qore.host/:path*"
    },
    {
      "source": "/api/qore/rpc/:path*",
      "destination": "https://rpc-testnet.qore.host/:path*"
    },
    {
      "source": "/api/qore/rpc",
      "destination": "https://rpc-testnet.qore.host/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data:; connect-src 'self' https://evm-testnet.qore.host; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
